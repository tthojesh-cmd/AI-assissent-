# --- LLM (backend only; never exposed to the browser) ---
OPENAI_API_KEY=your_api_key
# Optional: any OpenAI-compatible endpoint (Azure, OpenRouter, Ollama, vLLM ...)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# --- Database ---
# SQLite (default):  sqlite:///./data/agent.db
# PostgreSQL:        postgresql+psycopg2://agent:agent@localhost:5432/agent
DATABASE_URL=sqlite:///./data/agent.db
# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
# --- Desktop automation (OFF by default; runs on the machine hosting the backend) ---
DESKTOP_AUTOMATION=false
# name=command pairs separated by ';'  (no shell is ever used)
DESKTOP_ALLOWED_APPS=notepad=notepad.exe;calculator=calc.exe;paint=mspaint.exe
